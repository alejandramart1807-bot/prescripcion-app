{
  "name": "tinterno-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Tinterno — PWA de apoyo clínico para médicos en turno en Colombia. Monorepo (migración en curso desde index.html único).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "pnpm -r --if-present clean",
    "auditar": "node tools/audit-all.mjs",
    "linea-base": "node tools/audit-baseline.mjs",
    "test": "pnpm --filter @tinterno/engine test",
    "verificar": "pnpm auditar && pnpm test && pnpm build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
